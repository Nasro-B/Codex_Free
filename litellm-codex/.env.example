# ============================================
# Codex Free EN - LiteLLM proxy
# Copy this file to .env and fill in local values.
# NEVER COMMIT .env. It is ignored by Git.
# ============================================

# DeepSeek
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key

# Kimi / Moonshot AI
MOONSHOT_API_KEY=replace-with-your-moonshot-api-key

# CloudZIR Mina
CLOUDZIR_API_KEY=replace-with-your-cloudzir-api-key

# Optional NVIDIA providers
NVIDIA_API_KEY=replace-with-your-nvidia-api-key
NVIDIA_API_KEY_DEEPSEEK=replace-with-your-nvidia-deepseek-key
NVIDIA_API_KEY_GLM=replace-with-your-nvidia-glm-key

# Optional Hugging Face provider
HF_TOKEN=replace-with-your-huggingface-token
